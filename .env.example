# Records are {id,role,salt,iterations,hash}; roles are premium, mod, or admin.
# Generate PBKDF2-SHA256 records outside the repository. Never commit real values.
ACCESS_CREDENTIALS_JSON=[]
ACCESS_SESSION_SECRET=replace-with-a-long-random-server-only-secret
ACCESS_SESSION_TTL_SECONDS=2592000

# Durable moderation storage. The API returns 503 if this is unavailable.
MODERATION_KV_REST_API_URL=
MODERATION_KV_REST_API_TOKEN=
# Optional per-app key or namespace.
# MODERATION_STORE_KEY=
# MODERATION_STORE_NAMESPACE=

# Legacy names remain supported only for migration.
PREMIUM_PASSWORD_HASHES_JSON=[]
PREMIUM_SESSION_SECRET=
PREMIUM_SESSION_TTL_SECONDS=2592000

# Optional: use a server-side feedback endpoint when a destination is selected.
# VERTEX_FEEDBACK_URL=
